# JezzyERP Environment Variables Example
# Copy this file to .env and populate with actual credentials before running

# Database Connection (MySQL / PostgreSQL / SQLite)
DATABASE_URL="mysql://username:password@localhost:3306/jezzy_erp"

# Authentication & Security
JWT_SECRET="your_secure_32_character_jwt_secret_key_here"

# Application Configuration
NEXT_PUBLIC_APP_NAME="JezzyERP"
NEXT_PUBLIC_APP_URL="https://your-domain.vercel.app"

# Email / SMTP Configuration (Optional)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@example.com"
SMTP_PASS="your-app-password"
SMTP_FROM="JEZZY ENTERPRISES <no-reply@jezzy.in>"

# WhatsApp Gateway (Optional)
WHATSAPP_API_URL="https://api.whatsapp.com/v1/messages"
WHATSAPP_API_TOKEN="your_whatsapp_api_token"
